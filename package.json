{
  "name": "infocapture",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first quick capture for conference badge QR codes and business cards, synced to Excel in Microsoft 365.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "vendor": "node scripts/vendor.mjs",
    "assets": "python3 scripts/make_assets.py"
  },
  "devDependencies": {
    "@azure/msal-browser": "5.24.0",
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.10",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  }
}
